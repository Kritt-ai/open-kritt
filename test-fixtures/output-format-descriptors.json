  "payloadCases": [
    {
      "name": "valid chain payload passes",
      "outputFormat": {
        "impact_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "fields": {
              "id": "string",
              "status": {
                "type": "string",
                "enum": [
                  "proven",
                  "unverified"
                ]
              },
              "evidence_paths": {
                "type": "array",
                "items": "string"
              }
            }
          }
        }
      },
      "result": {
        "impact_chain": [
          {
            "id": "hop-1",
            "status": "proven",
            "evidence_paths": [
              "attack.log"
            ]
          }
        ]
      },
      "valid": true
    },
    {
      "name": "enum violation fails",
      "outputFormat": {
        "status": {
          "type": "string",
          "enum": [
            "a",
            "b"
          ]
        }
      },
      "result": {
        "status": "c"
      },
      "valid": false
    },
    {
      "name": "extra property inside declared object fails",
      "outputFormat": {
        "x": {
          "type": "object",
          "fields": {
            "a": "string"
          }
        }
      },
      "result": {
        "x": {
          "a": "1",
          "b": "2"
        }
      },
      "valid": false
    },
    {
      "name": "missing required nested field fails",
      "outputFormat": {
        "x": {
          "type": "object",
          "fields": {
            "a": "string",
            "b": "string"
          }
        }
      },
      "result": {
        "x": {
          "a": "1"
        }
      },
      "valid": false
    },
    {
      "name": "legacy array still accepts strings only",
      "outputFormat": {
        "paths": "array"
      },
      "result": {
        "paths": [
          {
            "not": "a string"
          }
        ]
      },
      "valid": false
    }
  ]
